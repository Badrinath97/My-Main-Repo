<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_After_Aired</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Aired_Date__c)), NOT(ISBLANK(Completed_Date__c)), Completed_Date__c &lt; Aired_Date__c)</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage
  >Completed date can&apos;t be before the aired date.</errorMessage>
</ValidationRule>
