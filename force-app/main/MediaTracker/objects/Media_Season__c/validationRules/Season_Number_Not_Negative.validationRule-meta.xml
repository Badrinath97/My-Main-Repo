<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Season_Number_Not_Negative</fullName>
    <active>true</active>
    <errorConditionFormula
  >OR(Season_Number__c &lt; 0, Episode_Count__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Season_Number__c</errorDisplayField>
    <errorMessage
  >Season number and episode count cannot be negative.</errorMessage>
</ValidationRule>
