<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Collection_Order_Positive</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Collection_Order__c)), Collection_Order__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Collection_Order__c</errorDisplayField>
    <errorMessage>Order in collection can&apos;t be negative.</errorMessage>
</ValidationRule>
