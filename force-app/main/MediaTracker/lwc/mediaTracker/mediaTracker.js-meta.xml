<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Media Tracker</masterLabel>
    <description
  >Track and manage movies, TV series, anime, books, games and more in one place.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig
      targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage"
    >
            <property
        name="cardTitle"
        type="String"
        label="Title"
        default="My Media Tracker"
      />
            <property
        name="mediaTypes"
        type="String"
        label="Limit to media types"
        description="Comma-separated Media Type values, e.g. Anime or Movie,TV Series. Leave blank to show everything."
      />
            <property
        name="defaultView"
        type="String"
        label="Default view"
        datasource="grid,list,collections"
        default="grid"
      />
            <property
        name="defaultSort"
        type="String"
        label="Default sort"
        datasource="lastModified,title,rating,releaseYear,progress,mediaType,status,collectionOrder"
        default="lastModified"
      />
            <property
        name="pageSize"
        type="Integer"
        label="Items per page"
        default="12"
        min="1"
        max="200"
      />
            <property
        name="hideStats"
        type="Boolean"
        label="Hide statistics"
        default="false"
      />
            <property
        name="hideAddButton"
        type="Boolean"
        label="Hide Add button"
        default="false"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
